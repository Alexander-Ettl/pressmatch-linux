diff --git a/src/system/parallel_auth.rs b/src/system/parallel_auth.rs
new file mode 100644
index 0000000..d62f147
--- /dev/null
+++ b/src/system/parallel_auth.rs
@@ -0,0 +1,259 @@
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::mem::MaybeUninit;
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use super::interface::ProcessId;
+use super::wait::{Wait, WaitError, WaitOptions};
+use super::{ForkResult, fork, kill};
+use crate::cutils::cerr;
+
+#[derive(Clone, Copy, Eq, PartialEq)]
+pub(crate) enum AttemptResult {
+    Matched = 1,
+    Exhausted = 2,
+    Failed = 3,
+}
+
+pub(crate) struct AuthTerminal {
+    tty: File,
+    original: libc::termios,
+    cancellation: Cancellation,
+}
+
+impl AuthTerminal {
+    pub(crate) fn open_foreground() -> io::Result<Self> {
+        let tty = OpenOptions::new().read(true).write(true).open("/dev/tty")?;
+        let fd = tty.as_raw_fd();
+        let mut settings = MaybeUninit::uninit();
+        // SAFETY: fd is open, getpgrp takes no arguments, and tcgetattr initializes settings on success.
+        unsafe {
+            if cerr(libc::tcgetpgrp(fd))? != libc::getpgrp() {
+                return Err(io::Error::other(
+                    "sudo does not own the terminal foreground",
+                ));
+            }
+            cerr(libc::tcgetattr(fd, settings.as_mut_ptr()))?;
+            Ok(Self {
+                tty,
+                original: settings.assume_init(),
+                cancellation: Cancellation::new()?,
+            })
+        }
+    }
+
+    pub(crate) fn restore(&self, discard_input: bool) -> io::Result<()> {
+        let action = if discard_input {
+            libc::TCSAFLUSH
+        } else {
+            libc::TCSANOW
+        };
+        // SAFETY: the tty is still open and original was obtained from tcgetattr.
+        cerr(unsafe { libc::tcsetattr(self.tty.as_raw_fd(), action, &self.original) })?;
+        Ok(())
+    }
+}
+
+/// Block cancellation signals before forking. signalfd makes delivery race-free
+/// while the supervisor is waiting on both result pipes.
+struct Cancellation {
+    fd: File,
+    previous: libc::sigset_t,
+}
+
+impl Cancellation {
+    fn new() -> io::Result<Self> {
+        let mut mask = MaybeUninit::uninit();
+        let mut previous = MaybeUninit::uninit();
+        // SAFETY: sigemptyset and sigprocmask initialize writable sigset_t values.
+        unsafe {
+            cerr(libc::sigemptyset(mask.as_mut_ptr()))?;
+            let mut mask = mask.assume_init();
+            for signal in [libc::SIGINT, libc::SIGQUIT, libc::SIGTERM, libc::SIGHUP] {
+                cerr(libc::sigaddset(&mut mask, signal))?;
+            }
+            cerr(libc::sigprocmask(
+                libc::SIG_BLOCK,
+                &mask,
+                previous.as_mut_ptr(),
+            ))?;
+            let previous = previous.assume_init();
+            match cerr(libc::signalfd(
+                -1,
+                &mask,
+                libc::SFD_CLOEXEC | libc::SFD_NONBLOCK,
+            )) {
+                Ok(fd) => Ok(Self {
+                    fd: File::from_raw_fd(fd),
+                    previous,
+                }),
+                Err(error) => {
+                    let _ = libc::sigprocmask(libc::SIG_SETMASK, &previous, std::ptr::null_mut());
+                    Err(error)
+                }
+            }
+        }
+    }
+
+    fn restore(&self) -> io::Result<()> {
+        // SAFETY: previous was initialized by sigprocmask.
+        cerr(unsafe {
+            libc::sigprocmask(libc::SIG_SETMASK, &self.previous, std::ptr::null_mut())
+        })?;
+        Ok(())
+    }
+
+    fn receive(&self) -> io::Result<i32> {
+        let mut info = MaybeUninit::<libc::signalfd_siginfo>::uninit();
+        let size = std::mem::size_of::<libc::signalfd_siginfo>();
+        // SAFETY: the fd is live and info is writable for size bytes.
+        let bytes =
+            cerr(unsafe { libc::read(self.fd.as_raw_fd(), info.as_mut_ptr().cast(), size) })?;
+        if bytes as usize != size {
+            return Err(io::Error::from(io::ErrorKind::UnexpectedEof));
+        }
+        // SAFETY: the full Linux signalfd record was read.
+        Ok(unsafe { info.assume_init() }.ssi_signo as i32)
+    }
+}
+
+impl Drop for Cancellation {
+    fn drop(&mut self) {
+        let _ = self.restore();
+    }
+}
+
+pub(crate) struct AuthWorker {
+    result: File,
+    pid: ProcessId,
+}
+
+impl AuthWorker {
+    /// Spawn only from sudo's single-threaded authentication phase. The result
+    /// pipe is private to the parent and this worker.
+    pub(crate) fn start(
+        terminal: &AuthTerminal,
+        background: bool,
+        authenticate: impl FnOnce() -> AttemptResult,
+    ) -> io::Result<Self> {
+        if std::fs::read_dir("/proc/self/task")?.take(2).count() != 1 {
+            return Err(io::Error::other(
+                "authentication workers require a single-threaded caller",
+            ));
+        }
+        let mut descriptors = [-1; 2];
+        // SAFETY: descriptors holds two writable c_int values.
+        cerr(unsafe { libc::pipe2(descriptors.as_mut_ptr(), libc::O_CLOEXEC) })?;
+        // SAFETY: successful pipe2 returned two newly owned file descriptors.
+        let (result, report) = unsafe {
+            (
+                File::from_raw_fd(descriptors[0]),
+                File::from_raw_fd(descriptors[1]),
+            )
+        };
+        // SAFETY: getpid takes no arguments.
+        let parent = unsafe { libc::getpid() };
+        // SAFETY: sudo is still single-threaded and has not started any PAM transactions.
+        match unsafe { fork()? } {
+            ForkResult::Parent(pid) => Ok(Self { result, pid }),
+            ForkResult::Child => {
+                drop(result);
+                // SAFETY: these calls operate on this child and take no pointers.
+                let parent_is_alive = unsafe {
+                    libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGTERM, 0, 0, 0) == 0
+                        && libc::getppid() == parent
+                        && (!background || libc::setpgid(0, 0) == 0)
+                };
+                if parent_is_alive && terminal.cancellation.restore().is_ok() {
+                    let _ = (&report).write_all(&[authenticate() as u8]);
+                }
+                // SAFETY: do not run parent cleanup code from this forked child.
+                unsafe { libc::_exit(0) }
+            }
+        }
+    }
+
+    fn result(&mut self) -> io::Result<AttemptResult> {
+        let mut result = [0];
+        match self.result.read_exact(&mut result) {
+            Ok(()) if result[0] == AttemptResult::Matched as u8 => Ok(AttemptResult::Matched),
+            Ok(()) if result[0] == AttemptResult::Exhausted as u8 => Ok(AttemptResult::Exhausted),
+            Ok(()) => Ok(AttemptResult::Failed),
+            Err(error) if error.kind() == io::ErrorKind::UnexpectedEof => Ok(AttemptResult::Failed),
+            Err(error) => Err(error),
+        }
+    }
+}
+
+impl Drop for AuthWorker {
+    fn drop(&mut self) {
+        // Until it is reaped the child still owns this PID. Give the worker time
+        // to restore terminal settings or to release the readers before escalating.
+        loop {
+            match self.pid.wait(WaitOptions::new().no_hang()) {
+                Err(WaitError::NotReady) => break,
+                Err(WaitError::Io(error)) if error.kind() == io::ErrorKind::Interrupted => continue,
+                _ => return,
+            }
+        }
+        let _ = kill(self.pid, libc::SIGTERM);
+        let deadline = Instant::now() + Duration::from_secs(1);
+        while Instant::now() < deadline {
+            match self.pid.wait(WaitOptions::new().no_hang()) {
+                Err(WaitError::NotReady) => thread::sleep(Duration::from_millis(10)),
+                Err(WaitError::Io(error)) if error.kind() == io::ErrorKind::Interrupted => continue,
+                _ => return,
+            }
+        }
+        let _ = kill(self.pid, libc::SIGKILL);
+        while let Err(WaitError::Io(error)) = self.pid.wait(WaitOptions::new()) {
+            if error.kind() != io::ErrorKind::Interrupted {
+                break;
+            }
+        }
+    }
+}
+
+/// Wait for the first finished worker, leaving individual retry loops in each child.
+pub(crate) fn next_result(
+    workers: &mut [Option<AuthWorker>; 2],
+    terminal: &AuthTerminal,
+) -> io::Result<(usize, AttemptResult)> {
+    loop {
+        let mut fds = [libc::pollfd {
+            fd: -1,
+            events: libc::POLLIN,
+            revents: 0,
+        }; 3];
+        for (fd, worker) in fds.iter_mut().zip(workers.iter()) {
+            if let Some(worker) = worker {
+                fd.fd = worker.result.as_raw_fd();
+            }
+        }
+        fds[2].fd = terminal.cancellation.fd.as_raw_fd();
+        // SAFETY: fds is initialized and contains three pollfd entries.
+        match cerr(unsafe { libc::poll(fds.as_mut_ptr(), fds.len() as _, -1) }) {
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+            Ok(_) => {}
+        }
+        if fds[2].revents != 0 {
+            let signal = terminal.cancellation.receive()?;
+            workers.fill_with(|| None);
+            terminal.restore(true)?;
+            terminal.cancellation.restore()?;
+            // SAFETY: reset the signal disposition and re-deliver to this process.
+            unsafe {
+                libc::signal(signal, libc::SIG_DFL);
+                libc::raise(signal);
+            }
+            return Err(io::Error::from(io::ErrorKind::Interrupted));
+        }
+        if let Some(index) = fds[..2].iter().position(|fd| fd.revents != 0) {
+            let mut worker = workers[index].take().expect("polled worker");
+            return worker.result().map(|result| (index, result));
+        }
+    }
+}
