+++ b/src/sudo/pam/parallel.rs
@@ -0,0 +1,125 @@
+use std::fs::symlink_metadata;
+use std::os::unix::fs::MetadataExt;
+
+use super::{InitPamArgs, attempt_authenticate, init_pam};
+use crate::common::Error;
+use crate::log::user_warn;
+use crate::pam::{PamContext, PamError, PamErrorType, PamResult};
+use crate::system::parallel_auth::{AttemptResult, AuthTerminal, AuthWorker, next_result};
+use crate::system::term::current_tty_name;
+
+const FINGERPRINT_SERVICE: &str = "sudo-pressmatch-fingerprint";
+const PASSWORD: usize = 0;
+
+pub(super) fn configuration(
+    args: &InitPamArgs<'_>,
+    stock: &str,
+) -> Option<(&'static str, AuthTerminal)> {
+    if args.non_interactive || args.use_askpass || args.use_stdin || current_tty_name().is_err() {
+        return None;
+    }
+    let password = if stock == "sudo-i" {
+        "sudo-pressmatch-password-i"
+    } else {
+        "sudo-pressmatch-password"
+    };
+    if !trusted_profile(password) || !trusted_profile(FINGERPRINT_SERVICE) {
+        return None;
+    }
+    Some((password, AuthTerminal::open_foreground().ok()?))
+}
+
+fn trusted_profile(service: &str) -> bool {
+    symlink_metadata(format!("/etc/pam.d/{service}")).is_ok_and(|metadata| {
+        metadata.is_file() && metadata.uid() == 0 && metadata.mode() & 0o022 == 0
+    })
+}
+
+pub(super) fn authenticate(
+    args: InitPamArgs<'_>,
+    stock: &str,
+    password_service: &str,
+    terminal: AuthTerminal,
+    tries: u16,
+) -> Result<PamContext, Error> {
+    // Both workers start before any PAM work in their parent.
+    let fingerprint = AuthWorker::start(&terminal, true, || {
+        if fingerprint_pam(&args).is_ok() {
+            AttemptResult::Matched
+        } else {
+            AttemptResult::Exhausted
+        }
+    })
+    .map_err(PamError::from)?;
+    let password = AuthWorker::start(&terminal, false, || {
+        password_pam(args.clone(), password_service, tries)
+    })
+    .map_err(PamError::from)?;
+    let mut workers = [Some(password), Some(fingerprint)];
+
+    while workers.iter().any(Option::is_some) {
+        let outcome = next_result(&mut workers, &terminal);
+        let (index, result) = match outcome {
+            Ok(value) => value,
+            Err(error) => {
+                drop(workers);
+                terminal.restore(true).map_err(PamError::from)?;
+                return Err(PamError::from(error).into());
+            }
+        };
+        match result {
+            AttemptResult::Matched => {
+                drop(workers);
+                terminal
+                    .restore(index != PASSWORD)
+                    .map_err(PamError::from)?;
+                // The parent uses the original sudo PAM account and session policy.
+                return Ok(init_pam(args, stock)?);
+            }
+            AttemptResult::Failed if index == PASSWORD => break,
+            _ if index == PASSWORD && workers[1].is_some() => user_warn!(
+                "Password authentication ended. Scan your fingerprint or press Ctrl+C to cancel."
+            ),
+            _ => {}
+        }
+    }
+    drop(workers);
+    terminal.restore(true).map_err(PamError::from)?;
+    Err(PamError::Pam(PamErrorType::AuthError).into())
+}
+
+fn password_pam(args: InitPamArgs<'_>, service: &str, tries: u16) -> AttemptResult {
+    let user = args.auth_user;
+    let result = init_pam(args, service)
+        .map_err(Error::from)
+        .and_then(|mut pam| attempt_authenticate(&mut pam, user, false, tries));
+    match result {
+        Ok(()) => AttemptResult::Matched,
+        Err(Error::MaxAuthAttempts(_) | Error::Pam(PamError::TimedOut)) => AttemptResult::Exhausted,
+        Err(error) => {
+            user_warn!("{error}", error = error);
+            AttemptResult::Failed
+        }
+    }
+}
+
+fn fingerprint_pam(args: &InitPamArgs<'_>) -> PamResult<()> {
+    let mut pam = PamContext::new_cli(
+        "sudo",
+        FINGERPRINT_SERVICE,
+        false,
+        false,
+        false,
+        true,
+        false,
+        None,
+        Some(args.auth_user),
+    )?;
+    pam.quiet_conversation();
+    pam.mark_allow_null_auth_token(false);
+    pam.set_requesting_user(args.requesting_user)?;
+    if let Ok(tty) = current_tty_name() {
+        pam.set_tty(&tty)?;
+    }
+    pam.authenticate(args.auth_user)
+}
